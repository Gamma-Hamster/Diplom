			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата окончания план</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДнейПлан</dataPath>
			<field>ДнейПлан</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дней план</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДнейФакт</dataPath>
			<field>ДнейФакт</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дней факт</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаНачалаФакт</dataPath>
			<field>ДатаНачалаФакт</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата начала факт</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаОкончанияФакт</dataPath>
			<field>ДатаОкончанияФакт</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата окончания факт</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Сотрудник</dataPath>
			<field>Сотрудник</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗЛИЧНЫЕ
	ВКМ_ГрафикОтпусковОтпускаСотрудников.ДатаНачала КАК ДатаНачалаПлан,
	ВКМ_ГрафикОтпусковОтпускаСотрудников.ДатаОкончания КАК ДатаОкончанияПлан,
	ВКМ_ГрафикОтпусковОтпускаСотрудников.Дней КАК ДнейПлан,
	ВКМ_ГрафикОтпусковОтпускаСотрудников.Сотрудник КАК Сотрудник
ПОМЕСТИТЬ вт_План
ИЗ
	Документ.ВКМ_ГрафикОтпусков.ОтпускаСотрудников КАК ВКМ_ГрафикОтпусковОтпускаСотрудников
ГДЕ
	ВКМ_ГрафикОтпусковОтпускаСотрудников.Ссылка.Год = &amp;Год

ИНДЕКСИРОВАТЬ ПО
	ДатаНачалаПлан,
	ДатаОкончанияПлан,
	ДнейПлан
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВКМ_НачислениеОтпускных.ДатаНачала КАК ДатаНачалаФакт,
	ВКМ_НачислениеОтпускных.ДатаОкончания КАК ДатаОкончанияФакт,
	ВКМ_НачислениеОтпускных.ДнейОтпуска КАК ДнейФакт,
	ВКМ_НачислениеОтпускных.Сотрудник КАК Сотрудник
ПОМЕСТИТЬ вт_Факт
ИЗ
	Документ.ВКМ_НачислениеОтпускных КАК ВКМ_НачислениеОтпускных
ГДЕ
	ВКМ_НачислениеОтпускных.Год = &amp;Год

ИНДЕКСИРОВАТЬ ПО
	ДатаНачалаФакт,
	ДатаОкончанияФакт,
	ДнейФакт
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	вт_План.ДатаНачалаПлан КАК ДатаНачалаПлан,
	вт_План.ДатаОкончанияПлан КАК ДатаОкончанияПлан,
	вт_План.ДнейПлан КАК ДнейПлан,
	NULL КАК ДатаНачалаФакт,
	NULL КАК ДатаОкончанияФакт,
	NULL КАК ДнейФакт,
	вт_План.Сотрудник КАК Сотрудник
ИЗ
	вт_План КАК вт_План

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	NULL,
	NULL,
	NULL,
	вт_Факт.ДатаНачалаФакт,
	вт_Факт.ДатаОкончанияФакт,
	вт_Факт.ДнейФакт,
	вт_Факт.Сотрудник
ИЗ
	вт_Факт КАК вт_Факт</query>
	</dataSet>
